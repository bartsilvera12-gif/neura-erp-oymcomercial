# =============================================================================
# Neura ERP — O&M Comercial  ·  .env.example
# Copiá a .env.local y completá los valores. NUNCA commitees .env* reales.
# Este archivo solo contiene NOMBRES de variables y valores NO secretos.
# =============================================================================

# --- Instancia monocliente (schema aislado) ---------------------------------
NEURA_CLIENT_SCHEMA=oymcomercial
NEURA_CLIENT_NAME=O&M Comercial
NEURA_INSTANCE_MODE=single_client
# Compat futura (no usados hoy por el código, alineados por prolijidad):
APP_DB_SCHEMA=oymcomercial
NEXT_PUBLIC_APP_DB_SCHEMA=oymcomercial

# --- Supabase (público) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor / secretos) -----------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa Postgres (pooler/pgbouncer). Usada por scripts y pool de chat.
SUPABASE_DB_URL=
DATABASE_URL=
DIRECT_URL=
SUPABASE_DB_PASSWORD=
PG_POOL_MAX=10

# --- SIFEN (facturación electrónica PY) — pendiente de configuración ---------
# NO reutilizar certificados/RUC/timbrado del cliente origen.
SIFEN_SECRETS_KEY=
SIFEN_WORKER_DISABLED=true

# --- WhatsApp / Meta / YCloud (omnicanal) — pendiente de configuración -------
# Dejar vacío hasta aprovisionar canal propio de O&M Comercial.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_DEFAULT_EMPRESA_ID=
WHATSAPP_LINK_PHONE_NUMBER=
NEXT_PUBLIC_WHATSAPP_LINK_PHONE_NUMBER=
YCLOUD_WEBHOOK_EMPRESA_ID=

# --- Integraciones opcionales ------------------------------------------------
GOOGLE_CLOUD_VISION_API_KEY=
WEBHOOK_SECRET=
WEBHOOK_URL=
CRM_WEBHOOK_EMPRESA_ID=
RAFFLES_N8N_SECRET=
QA_SORTEO_TICKET_SECRET=

# --- Super admin bootstrap (opcional) ---------------------------------------
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# --- Facturación (defaults de negocio) --------------------------------------
FACTURA_PREFIJO=
FACTURA_DIAS_CREDITO_DEFAULT=
